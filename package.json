{
  "name": "weixtrom",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:migrate": "npm run migrate --workspace=@weixtrom/api",
    "db:seed": "npm run seed --workspace=@weixtrom/api",
    "db:studio": "npm run studio --workspace=@weixtrom/api"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.10.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.8.0"
}
